# ============================================================
# OrioSearch — Coolify Deployment Environment Variables
# ============================================================
# Copy to .env and fill in real values, or set in Coolify UI.
# Generate secrets with: openssl rand -hex 32

# --- REQUIRED ---

# Public domain for the API (Coolify sets this automatically if you
# configure it in the service settings). Used by Traefik to route.
SERVICE_FQDN_API_8000=https://orio.example.com

# Client-facing API keys — comma-separated if multiple clients.
# Every request to /search, /extract, /search/local needs:
#   Authorization: Bearer <one-of-these-keys>
API_AUTH_KEYS=change-me-to-a-long-random-string

# Internal secret for SearXNG (session signing). 32+ bytes.
SEARXNG_SECRET=change-me-via-openssl-rand-hex-32

# Master key for Meilisearch (admin + index write). 32+ bytes.
MEILI_MASTER_KEY=change-me-via-openssl-rand-hex-32

# Password for internal Redis (cache + rate limit store). 32+ bytes.
REDIS_PASSWORD=change-me-via-openssl-rand-hex-32

# Docker image tag — build and push via CI, or set to :latest if using
# Coolify's built-in build.
ORIO_IMAGE=ghcr.io/yourname/orio-search:latest


# --- OPTIONAL: persistent data volumes ---
# By default, both Redis and Meilisearch use Docker named volumes (managed
# by Coolify in its default data dir). To point either at a separately
# mounted disk for more space, set an absolute host path. The directory
# must exist on the host before the container starts. Per-service so you
# can split fast vs bulk storage if needed.
#
# MEILI_DATA_PATH=/mnt/bigdisk/orio/meili
# REDIS_DATA_PATH=/mnt/bigdisk/orio/redis


# --- OPTIONAL ---

# Enable LLM-based answer generation.
LLM_ENABLED=false
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# CORS whitelist (comma-separated). Leave empty to reject browser
# cross-origin requests; set to "*" only if the API is intentionally public.
# CORS_ORIGINS=https://app.example.com,https://another.example.com
